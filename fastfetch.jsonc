{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/omarchy/current/theme/fastfetch-logo.txt",
    "color": { "1": "#3D73E8", "2": "#AAB8F5" },
    "padding": { "top": 1, "right": 5, "left": 2 }
  },
  "display": { "separator": "  " },
  "modules": [
    "break",
    { "type": "custom", "format": "\u001b[38;2;170;184;245m┌── SYSTEM / RESEARCH NODE ──────────────────┐" },
    { "type": "host", "key": "  host", "keyColor": "blue" },
    { "type": "os", "key": "  os", "keyColor": "blue" },
    { "type": "kernel", "key": "  kernel", "keyColor": "blue" },
    { "type": "terminal", "key": "  terminal", "keyColor": "blue" },
    { "type": "packages", "key": "  packages", "keyColor": "blue" },
    { "type": "wmtheme", "key": "  theme", "keyColor": "blue" },
    { "type": "custom", "format": "\u001b[38;2;170;184;245m└─────────────────────────────────────────────┘" },
    "break",
    { "type": "cpu", "key": "  cpu", "keyColor": "cyan" },
    { "type": "memory", "key": "  memory", "keyColor": "cyan" },
    { "type": "disk", "key": "  disk", "keyColor": "cyan" },
    "break"
  ]
}
