{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/omarchy/current/theme/fastfetch-logo.txt",
    "color": { "1": "#9FB7FF", "2": "#0000F2" },
    "padding": { "top": 0, "right": 4, "left": 0 }
  },
  "display": { "separator": "  ", "color": "#DCE8FF", "brightColor": false },
  "modules": [
    { "type": "custom", "format": "\u001b[38;2;159;183;255m  +-- NOUS RESEARCH / FIELD NOTE ----------------+" },
    { "type": "host", "key": "  | host", "keyColor": "#9FB7FF" },
    { "type": "cpu", "key": "  | cpu", "keyColor": "#9FB7FF", "showPeCoreCount": true },
    { "type": "gpu", "key": "  | gpu", "keyColor": "#9FB7FF", "detectionMethod": "pci" },
    { "type": "display", "key": "  | display", "keyColor": "#9FB7FF" },
    { "type": "memory", "key": "  | memory", "keyColor": "#9FB7FF" },
    { "type": "disk", "key": "  + disk", "keyColor": "#9FB7FF", "folders": "/" },
    { "type": "custom", "format": "\u001b[38;2;159;183;255m  +---------------------------------------------+" },
    { "type": "custom", "format": "\u001b[38;2;191;197;255m  +-- SOFTWARE / SESSION -----------------------+" },
    { "type": "command", "key": "  | omarchy", "keyColor": "#BFC5FF", "text": "omarchy-version" },
    { "type": "kernel", "key": "  | kernel", "keyColor": "#BFC5FF" },
    { "type": "wm", "key": "  | wm", "keyColor": "#BFC5FF" },
    { "type": "terminal", "key": "  | terminal", "keyColor": "#BFC5FF" },
    { "type": "packages", "key": "  + packages", "keyColor": "#BFC5FF" },
    { "type": "custom", "format": "\u001b[38;2;191;197;255m  +---------------------------------------------+" },
    { "type": "uptime", "key": "  o uptime", "keyColor": "#8BD6E5" },
    { "type": "command", "key": "  o theme", "keyColor": "#8BD6E5", "text": "omarchy-theme-current" },
    { "type": "command", "key": "  o signal", "keyColor": "#8BD6E5", "text": "printf '\\033[38;2;0;0;242m● \\033[38;2;107;194;176m● \\033[38;2;159;183;255m● \\033[38;2;235;129;149m●\\033[0m'" }
  ]
}
