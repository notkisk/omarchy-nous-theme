#################################
# Field Notes — btop Color Theme
#################################

# The monitor is intentionally the dark 'instrument panel' counterpart to the
# paper desktop: navy ground, periwinkle signals, restrained status colors.
theme[main_bg]         = "#08152E"
theme[title]           = "#AAB8F5"
theme[hi_fg]           = "#6E98F5"

theme[selected_bg]     = "#2458C6"
theme[selected_fg]     = "#FFFFFF"
theme[inactive_fg]     = "#8FA0BD"

theme[cpu_box]         = "#38517D"
theme[mem_box]         = "#38517D"
theme[net_box]         = "#38517D"
theme[proc_box]        = "#38517D"
theme[div_line]        = "#38517D"

theme[graph_text]      = "#EAF0FF"
theme[proc_misc]       = "#AAB8F5"

theme[temp_start]      = "#4F9B8C"
theme[temp_mid]        = "#C28A39"
theme[temp_end]        = "#C75E6A"

theme[cpu_start]       = "#172B4D"
theme[cpu_mid]         = "#3D73E8"
theme[cpu_end]         = "#AAB8F5"

theme[free_start]      = "#08152E"
theme[free_mid]        = "#2458C6"
theme[free_end]        = "#6E98F5"
theme[cached_start]    = "#08152E"
theme[cached_mid]      = "#4C9CB2"
theme[cached_end]      = "#AAB8F5"
theme[available_start] = "#08152E"
theme[available_mid]   = "#4F9B8C"
theme[available_end]   = "#66B5A5"
theme[used_start]      = "#08152E"
theme[used_mid]        = "#C28A39"
theme[used_end]        = "#DFAC5B"

theme[download_start]  = "#08152E"
theme[download_mid]    = "#3D73E8"
theme[download_end]    = "#AAB8F5"
theme[upload_start]    = "#08152E"
theme[upload_mid]      = "#4C9CB2"
theme[upload_end]      = "#76C5D9"

theme[process_start]   = "#172B4D"
theme[process_mid]     = "#3D73E8"
theme[process_end]     = "#AAB8F5"
