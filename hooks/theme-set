#!/usr/bin/env bash
# Optional surfaces that are not copied by Omarchy's color-template pass.
set -euo pipefail

THEME_NAME="${1:-}"
[[ "$THEME_NAME" == "nous-research" || "$THEME_NAME" == "nous-research-theme" ]] || exit 0

CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}"
THEME_DIR="$CONFIG_ROOT/omarchy/current/theme"

# Fastfetch is intentionally opt-in at runtime: the portrait only appears
# when fastfetch is launched, never in ordinary Kitty sessions.
if [[ -f "$THEME_DIR/fastfetch.jsonc" ]]; then
  mkdir -p "$CONFIG_ROOT/fastfetch"
  cp "$THEME_DIR/fastfetch.jsonc" "$CONFIG_ROOT/fastfetch/config.jsonc"
fi
if [[ -f "$THEME_DIR/fastfetch-logo.txt" ]]; then
  mkdir -p "$CONFIG_ROOT/omarchy/branding"
  cp "$THEME_DIR/fastfetch-logo.txt" "$CONFIG_ROOT/omarchy/branding/nous-girl.txt"
fi

# Full Waybar layout is kept optional in the theme directory so a user's
# custom Waybar can be restored simply by removing these two files.
if [[ -f "$THEME_DIR/waybar/config.jsonc" && -f "$THEME_DIR/waybar/style.css" ]]; then
  mkdir -p "$CONFIG_ROOT/waybar"
  cp "$THEME_DIR/waybar/config.jsonc" "$CONFIG_ROOT/waybar/config.jsonc"
  cp "$THEME_DIR/waybar/style.css" "$CONFIG_ROOT/waybar/style.css"
fi

if [[ -f "$THEME_DIR/fuzzel.ini" ]]; then
  mkdir -p "$CONFIG_ROOT/fuzzel"
  cp "$THEME_DIR/fuzzel.ini" "$CONFIG_ROOT/fuzzel/fuzzel.ini"
fi

if [[ -f "$THEME_DIR/gtk.css" ]]; then
  mkdir -p "$CONFIG_ROOT/gtk-3.0" "$CONFIG_ROOT/gtk-4.0"
  cp "$THEME_DIR/gtk.css" "$CONFIG_ROOT/gtk-3.0/gtk.css"
  cp "$THEME_DIR/gtk.css" "$CONFIG_ROOT/gtk-4.0/gtk.css"
fi

if [[ -f "$THEME_DIR/starship.toml" ]]; then
  cp "$THEME_DIR/starship.toml" "$CONFIG_ROOT/starship.toml"
fi

# Set GTK/desktop settings for the Nous light aesthetic.
# - Adwaita (light) + prefer-light keeps GTK/libadwaita apps on the light
#   surfaces defined in gtk.css, so un-themed widgets (file chooser
#   dialogs, message dialogs, unfocused headerbars) never fall back dark.
# - cursor-theme Adwaita keeps pointer contrast on light surfaces.
if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface gtk-theme Adwaita        >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.interface color-scheme prefer-light >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.interface cursor-theme Adwaita      >/dev/null 2>&1 || true
fi

command -v omarchy-restart-waybar >/dev/null 2>&1 && omarchy-restart-waybar || true
command -v omarchy-restart-walker >/dev/null 2>&1 && omarchy-restart-walker || true

# Re-apply Neovim background reinforcement layer so transparency.lua
# always matches the current theme surface colours.
if [[ -f "$THEME_DIR/nvim/transparency.lua" ]]; then
  mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/nvim/plugin/after"
  cp "$THEME_DIR/nvim/transparency.lua" \
     "${XDG_CONFIG_HOME:-$HOME/.config}/nvim/plugin/after/transparency.lua"
fi
